{
  "name": "kayg",
  "private": true,
  "version": "0.1.0",
  "description": "KayG is an independent open-source Grok Build GUI and cross-platform desktop client by Technodweep",
  "author": "Technodweep",
  "license": "Apache-2.0",
  "homepage": "https://www.technodweep.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technodweep/grok-build-gui.git"
  },
  "bugs": {
    "url": "https://github.com/technodweep/grok-build-gui/issues"
  },
  "keywords": [
    "grok-build",
    "grok-build-gui",
    "grok-desktop",
    "grok-cli",
    "tauri",
    "agent-client-protocol"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:raw": "pnpm --dir apps/desktop tauri dev",
    "build": "pnpm --dir apps/desktop tauri build",
    "build:linux": "./scripts/build-linux.sh",
    "ui:dev": "pnpm --dir apps/desktop dev",
    "ui:build": "pnpm --dir apps/desktop build",
    "typecheck": "pnpm --dir apps/desktop exec tsc --noEmit",
    "cargo:check": "cargo check -p kayg",
    "cargo:test": "cargo test -p kayg",
    "cargo:clippy": "cargo clippy -p kayg --all-targets -- -D warnings",
    "cargo:fmt": "cargo fmt -p kayg",
    "ci": "./scripts/ci-local.sh"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  }
}
