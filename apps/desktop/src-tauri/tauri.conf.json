{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KayG",
  "version": "0.1.0",
  "identifier": "dev.technodweep.kayg",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KayG",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": "#0c0e12",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Technodweep",
    "category": "DeveloperTool",
    "shortDescription": "Technodweep desktop client compatible with the Grok Build CLI",
    "longDescription": "KayG is an independent, open-source desktop coding-agent client from Technodweep, compatible with the Grok Build CLI. It connects to grok agent stdio over the Agent Client Protocol and requires the Grok CLI to be installed separately.",
    "copyright": "Copyright © 2026 Technodweep",
    "homepage": "https://www.technodweep.com/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "devel",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "externalBin": [],
    "resources": []
  },
  "plugins": {}
}
